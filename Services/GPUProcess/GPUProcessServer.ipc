#include <LibCore/AnonymousBuffer.h>
#include <LibGfx/Rect.h>
#include <LibGfx/ShareableBitmap.h>
#include <LibIPC/TransportHandle.h>

endpoint GPUProcessServer
{
    init_transport(int peer_pid) => (int peer_pid)

    connect_new_clients(size_t count) => (Vector<IPC::TransportHandle> handles)

    // Resource registration
    register_typeface(u64 typeface_id, Core::AnonymousBuffer font_data, u32 ttc_index) =|
    register_font(u64 font_id, u64 typeface_id, float point_size) =|
    register_image(u64 image_id, Gfx::ShareableBitmap bitmap) =|
    release_typeface(u64 typeface_id) =|
    release_font(u64 font_id) =|
    release_image(u64 image_id) =|

    // Backing stores (using ShareableBitmap for Linux; FIXME: IOSurface for macOS)
    update_backing_stores(u64 page_id, i32 front_bitmap_id, Gfx::ShareableBitmap front_bitmap, i32 back_bitmap_id, Gfx::ShareableBitmap back_bitmap) =|

    // Display list submission
    submit_display_list(u64 page_id, Core::AnonymousBuffer display_list_buffer) =|

    // Scroll state update (fast path — reuse cached display list)
    update_scroll_state(u64 page_id, Core::AnonymousBuffer scroll_state_buffer) =|

    // Presentation
    present_frame(u64 page_id, Gfx::IntRect viewport_rect) =|
}
